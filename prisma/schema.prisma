// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  // output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TypeReceipt {
  RECEIPT_UPLOAD
  RECEIPT_MANUAL
}
enum METHODEPAYMENT {
  qris
  gopay
  shopeepay
  bca
  bri
  bni
  mandiri
}
enum BILLINGCYCLE {
  monthly
  yearly
}
enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  EXPIRED
}

model Account {
  id                 String  @id @default(cuid())
  userId             String  @map("user_id")
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
 
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@unique([provider, providerAccountId])
  @@map("accounts")
}
 
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
 
  @@map("sessions")
}
 
model User {
  id                String        @id @default(cuid())
  name              String?
  email             String?       @unique
  whatsappNumber    String?       @unique
  image             String?
  emailVerified     DateTime?     @map("email_verified")
  password          String? 
  kuota             Int           @default(10)
  roleId            String        @default("cl-user") @map("role_id")
  license_id        String        @default("l-free-tier") @map("license_id")
  licenseEndDate    DateTime?     @map("license_end_date")
  accounts          Account[]
  sessions          Session[]
  receipts          Receipt[]
  layouts           Layout[]
  settings          Settings[]
  transactions      LicenseTRX[]
  lastLogin         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  license License @relation(fields: [license_id], references: [id], onDelete: Cascade)
  role RolesUser @relation(fields: [roleId], references: [id], onDelete: Cascade)
 
  @@map("user")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime
 
  @@unique([identifier, token])
  @@map("verification_tokens")
}

model RolesUser {
  id                String    @id @default(cuid())
  role              String?   @unique
  users             User[]

  @@map("roles_user")
}

model Receipt {
  id        String        @id @default(cuid())
  nama      String
  userId    String
  layoutId  String?
  type      TypeReceipt
  content   Json
  total     Float?   

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)  
  layout    Layout?       @relation(fields: [layoutId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("receipts")
}

model Layout {
  id          String   @id @default(cuid())
  name        String   
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault   Boolean  @default(false) 
  config      Json     
  receipts    Receipt[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("layouts")
}

model Settings {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  data        Json


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model UserStatistic {
  id                String    @id @default(uuid())
  userId            String
  date              DateTime  @db.Date
  
  pdfCount          Int       @default(0)
  imageCount        Int       @default(0)
  directPrintCount  Int       @default(0)

  @@unique([userId, date])
  @@index([userId, date])

  @@map("user_statistics")
}

model License {
  id              String          @id @default(cuid())
  name            String          @unique
  description     String
  features        Json
  users           User[]
  colorTheme      String
  buttonTheme     String
  priceMonthly    Float
  priceYearly     Float
  discount        Float?   
  icon            String      
  branding        String?         
  levelLicense    Int             @unique @map("level_license")
  pembelian       Int             @default(0)
  Transactions    LicenseTRX[]
  
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@map("license")
}

model LicenseTRX {
  id            String            @id @default(cuid())
  userId        String            @map("user_id")
  licenseId     String            @map("license_id")
  total         Float   
  billingCycle  BILLINGCYCLE      @map("billing_cycle")
  
  status        TransactionStatus @default(PENDING)
  paymentMethod METHODEPAYMENT    @map("payment_method") 
  paymentCode   String?           @map("payment_code")   
  expiredDate   DateTime          @map("expired_date")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  license       License           @relation(fields: [licenseId], references: [id])

  @@map("license_transactions")
}